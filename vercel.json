{
  "headers": [
    {
      "source": "/Frineve-Presupuesto-FR-01.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Frineve-Presupuesto-FR-01.pdf\"" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/(.*)\\.(html|pdf|png|jpg|jpeg|svg|webp|js|css|ico)", "destination": "/$1.$2" }
  ],
  "cleanUrls": true
}